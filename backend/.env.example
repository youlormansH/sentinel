# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME=Sentinel
ENVIRONMENT=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_DEV_ONLY_INSECURE_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AES_ENCRYPTION_KEY=CHANGE_ME_DEV_ONLY_32_BYTE_KEY!!

DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@db:5432/sentinel
SYNC_DATABASE_URL=postgresql://sentinel:sentinel@db:5432/sentinel

REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=["http://localhost:3000"]

# AI Security Analyst — required for the /ai/query endpoint to work.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

FRONTEND_URL=http://localhost:3000

FIRST_ADMIN_EMAIL=admin@sentinel.internal
FIRST_ADMIN_PASSWORD=ChangeMe123!
